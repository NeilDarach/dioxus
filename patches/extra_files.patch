+    async fn write_extra_files(&self, _ctx: &BuildContext, root_dir: &Path) -> Result<()> {
+        if self.bundle == BundleFormat::Ios {
+            tracing::warn!("Copying files into {}", root_dir.display());
+            if let Some(settings) = &self.config.bundle.macos {
+                for (k, v) in &settings.files {
+                    if v.is_file() {
+                        let dest = root_dir.join(k);
+                        tracing::debug!("copying {v:?} to {dest:?}",);
+                        std::fs::copy(v, &dest)
+                            .context("Failed to copy an extra file to output dir ectory")?;
+                    }
+                }
+            }
+        }
+        Ok(())
+    }
